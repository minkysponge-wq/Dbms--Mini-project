# Copy to .env.local and adjust for your machine.
RAFTKV_DB_HOST=127.0.0.1
RAFTKV_DB_PORT=3306
RAFTKV_DB_USER=root
RAFTKV_DB_PASSWORD=
RAFTKV_DB_NAME=raftkv

RAFTKV_MONGO_URI=mongodb://127.0.0.1:27017
RAFTKV_MONGO_DB=raftkv_events

# Where server.py is listening.
RAFTKV_CLUSTER_API=http://127.0.0.1:8080

# Change this. Any long random string.
RAFTKV_JWT_SECRET=change-me-to-a-long-random-string
